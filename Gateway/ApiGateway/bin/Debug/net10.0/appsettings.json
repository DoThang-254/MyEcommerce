{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Key": "Chuoi_Secret_Key_Sieu_Bao_Mat_Cua_Ban_Toi_Thieu_32_Ky_Tu",
    "Issuer": "MyAuthService",
    "Audience": "MyApiGateway"
  },

  "ReverseProxy": {
    "Routes": {
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/Products/{**catch-all}"
        }
      },

      "login-route": {
        "ClusterId": "user-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/User/login"
        }
      },

      "user-service-route": {
        "ClusterId": "user-cluster",
        "Order": 2, 
        "Match": {
          "Path": "/api/user/{**remainder}"
        },
        "AuthorizationPolicy": "AuthenticatedPolicy"
      }

    },
    "Clusters": {
      "product-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://product-service:80"
          }
        }
      },

      "user-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://user-service:80"
          }
        }
      }
    }
  }
}