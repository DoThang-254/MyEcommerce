        // Seed Product
        modelBuilder.Entity<Product>().HasData(new
        {
            Id = productId,
            Name = "Bản tin công nghệ FU-News",
            CreatedDate = DateTime.Parse("2026-04-01"),
            CreatedBy = "Thắng" //
            
        });

        // Seed Price (Owned Type)
        modelBuilder.Entity<Product>().OwnsOne(p => p.Price).HasData(new
        {
            ProductId = productId,
            Amount = 0.00m,
            Currency = "VND"
        });
    }
}
